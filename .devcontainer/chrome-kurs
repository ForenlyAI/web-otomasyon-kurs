#!/usr/bin/env bash
# Codespaces/konteyner içinde Chrome'un kum havuzu (sandbox) açılamaz; Selenium bu sarmalayıcıyla
# Playwright'ın indirdiği Chromium'u --no-sandbox ile başlatır. Ders kodlarında değişiklik gerekmez.
# (SE_BROWSER_PATH ile devcontainer.json'da tanımlı; kendi bilgisayarınızda bu dosya kullanılmaz.)
CHROME=$(ls -d "$HOME"/.cache/ms-playwright/chromium-*/chrome-linux*/chrome 2>/dev/null | sort -V | tail -1)
exec "$CHROME" --no-sandbox --disable-dev-shm-usage "$@"
